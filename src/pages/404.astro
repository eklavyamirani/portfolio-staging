---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Not found">
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow mono">404 · −50¢</p>
      <h1>Way off pitch.</h1>
      <p class="lead">That page doesn't exist.</p>
      <div class="cta"><a class="btn btn--primary" href={base}>Back to the start</a></div>
    </div>
  </section>
</Base>
